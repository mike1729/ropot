{
  "lora": {
    "task_type": "CAUSAL_LM",
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0,
    "target_modules": ["FULL_TEXT_BACKBONE_PROJECTION_NAME"],
    "bias": "none",
    "use_rslora": false,
    "init_lora_weights": true
  },
  "training_args": {
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 4,
    "learning_rate": 0.0001,
    "lr_scheduler_type": "constant",
    "warmup_steps": 0,
    "optim": "adamw_torch",
    "weight_decay": 0,
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "adam_epsilon": 1e-8,
    "max_grad_norm": 1.0,
    "activation_checkpointing": true,
    "activation_checkpointing_kwargs": {"use_reentrant": false},
    "bf16": true,
    "tf32": false,
    "use_cpu": false,
    "dataloader_drop_last": false,
    "dataloader_num_workers": 0,
    "dataloader_pin_memory": true,
    "seed": 17,
    "data_seed": 17,
    "remove_unused_columns": false,
    "save_only_model": false,
    "logging_strategy": "steps",
    "logging_steps": 1,
    "logging_nan_inf_filter": false,
    "report_to": "none",
    "disable_tqdm": true
  },
  "resume_atol": 0.000001,
  "resume_rtol": 0.00001,
  "budgets": {
    "max_tokens": 1000000,
    "max_wall_seconds": 1800,
    "max_cost_usd": 5,
    "gpu_hourly_usd": 5,
    "min_free_memory_bytes": 4294967296
  }
}
